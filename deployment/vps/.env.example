# Copy to deployment/vps/.env on the server and fill in. Never commit the real .env.

# ClickHouse admin (used only for schema/restore from inside the container)
CLICKHOUSE_ADMIN_USER=crypto_admin
CLICKHOUSE_ADMIN_PASSWORD=change-me

# Read-only ClickHouse user that Superset connects with (user name is fixed: superset)
CLICKHOUSE_SUPERSET_PASSWORD=change-me

# Superset: generate with `openssl rand -base64 42`
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# Superset binds to 127.0.0.1 on this port
SUPERSET_LOCAL_PORT=8088

# Public embed (bi.apps.leadmeter.ru). Secrets stay server-side, never in the Leadmeter page.
# Signs guest tokens; generate with `openssl rand -base64 48` (Superset's default is public)
GUEST_TOKEN_JWT_SECRET=change-me
# Service account of the embed-token service (role EmbedTokenIssuer only)
SUPERSET_EMBED_SERVICE_USER=embed_token_svc
SUPERSET_EMBED_SERVICE_PASSWORD=change-me
# Explicit https origins of the embedding page, comma-separated, no wildcards
EMBED_ALLOWED_ORIGINS=https://leadmeter.ru,https://www.leadmeter.ru
# Embedded uuid printed by setup_embedding.py (not secret; also in Caddyfile and the page)
EMBED_DASHBOARD_UUID=
