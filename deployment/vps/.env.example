# Copy to deployment/vps/.env on the server and fill in. Never commit the real .env.

# ClickHouse admin (used only for schema/restore from inside the container)
CLICKHOUSE_ADMIN_USER=crypto_admin
CLICKHOUSE_ADMIN_PASSWORD=change-me

# Read-only ClickHouse user that Superset connects with (user name is fixed: superset)
CLICKHOUSE_SUPERSET_PASSWORD=change-me

# Superset: generate with `openssl rand -base64 42`
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# Superset binds to 127.0.0.1 on this port
SUPERSET_LOCAL_PORT=8088
